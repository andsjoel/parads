# Server only. Never prefix these variables with VITE_.
FIREBASE_ADMIN_PROJECT_ID=parads-app-26f23
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Absent: login only. true: invite onboarding too. false: entire gateway off.
# Enable onboarding only in an approved deployment with compatible rules.
# PARADS_ACCESS_GATEWAY_ENABLED=true
# Emergency switches, all server-only and inactive when absent.
# PARADS_REGISTRATION_DISABLED=true
# PARADS_PASSWORD_RECOVERY_DISABLED=true
# PARADS_API_OPERATIONS_PAUSED=true
